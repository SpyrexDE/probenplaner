# Application Environment
APP_ENV=production

# APP Configuration
# Password for the super-admin login (/admin, user "admin"). Choose a long random value.
ADMIN_PW=change-me

# Database Configuration
DB_HOST=db
DB_USER=probenplaner
DB_PASSWORD=change-me
DB_NAME=probenplaner

# MySQL Root Credentials
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=probenplaner
MYSQL_USER=probenplaner
MYSQL_PASSWORD=change-me

# PHPMyAdmin Configuration
PMA_HOST=db

# Web Server Port Mappings
WEB_PORT=80
PHPMYADMIN_PORT=8081
MYSQL_PORT=3306

DOMAIN=localhost
CERT_PATH=/etc/ssl/certs/


# KEYCLOAK (JMD account login)
# true, or unset/empty = Keycloak on: "Mit JMD Account einloggen" on the login and invite pages,
#                        /auth/keycloak/* routes and JOinJMD token login, in addition to local login.
# false               = Keycloak off (instances without Keycloak): those buttons and routes are hidden
#                        or disabled; local e-mail/password login and registration keep working.
#                        Note: invite links marked "Nur JMD-Accounts" (keycloak_only) are still
#                        enforced, so do not use that option on such instances.
# Older versions ignored "false" (Keycloak was always on). A JMD instance whose .env was copied
# from this file must remove this line or set it to true before deploying.
KEYCLOAK_ENABLED=false
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_REDIRECT_URI=https://yourdomain.com/auth/keycloak/callback

# JOINJMD PARTNER API (/api/v1, see docs/partner-api.md)
# Shared secret the JOinJMD server sends as "Authorization: Bearer <token>".
# Empty = API off (all /api/v1 routes answer 404). Generate with: openssl rand -hex 32
PARTNER_API_TOKEN=
# Slug of the organization that orchestras created through the API belong to
PARTNER_API_ORG=

# JOINJMD PUSH (reminders to members without a response)
# Empty URL = no push; the reminder action is hidden.
JMD_PUSH_URL=
JMD_PUSH_TOKEN=
