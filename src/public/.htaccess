# Enable URL rewriting
RewriteEngine On

# Configure strict Basic Auth passthrough for Apple Calendar (SabreDAV)
CGIPassAuth On

# Set the base directory
RewriteBase /

# CalDAV Autodiscovery (Required for Apple Calendar and iOS)
RewriteCond %{HTTP:X-Forwarded-Proto} =https [OR]
RewriteCond %{HTTPS} =on
RewriteRule ^\.well-known/caldav(.*)$ https://%{HTTP_HOST}/caldav/ [R=301,L]

RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTPS} !=on
RewriteRule ^\.well-known/caldav(.*)$ http://%{HTTP_HOST}/caldav/ [R=301,L]

# Pass Authorization header explicitly as fallback
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# CalDAV endpoint - route everything to caldav/index.php
RewriteRule ^caldav(?:/.*)?$ caldav/index.php [E=HTTP_AUTHORIZATION:%{HTTP:Authorization},L,QSA]

# Redirect to index.php if the requested file or directory doesn't exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Prevent directory listing
Options -Indexes

# Set default character set
AddDefaultCharset UTF-8

# Enable compression for better performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json
</IfModule>

# Set security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    # Header set X-Frame-Options "SAMEORIGIN"
    Header set Content-Security-Policy "frame-ancestors 'self' https://chat.digil.me;"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Set cache control for assets
<FilesMatch "\.(jpg|jpeg|png|gif|ico|css|js)$">
    Header set Cache-Control "max-age=2592000, public"
</FilesMatch> 