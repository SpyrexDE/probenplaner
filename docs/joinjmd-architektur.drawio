<mxfile host="app.diagrams.net">
  <diagram id="joinjmd-architektur" name="Architektur">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="keycloak" value="Keycloak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="20" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="app" value="JOinJMD-App" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="server" value="JOinJMD-Server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pp" value="Probenplaner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="140" width="180" height="260" as="geometry" />
        </mxCell>

        <mxCell id="e-login" value="Login" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="keycloak">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-token" value="Token prüfen" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pp" target="keycloak">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-kachel" value="Kachel öffnen&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;GET /?jmd_accesstoken=…&amp;amp;orchestra={id}&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.115;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="pp">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-20" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e-partner" value="&lt;font face=&quot;Courier New&quot;&gt;PUT|DELETE /api/v1/orchestras/{id}&lt;br&gt;…/leaders/{sub}&lt;br&gt;…/members/{sub}&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.827;entryDx=0;entryDy=0;" edge="1" parent="1" source="server" target="pp">
          <mxGeometry x="-0.85" relative="1" as="geometry">
            <mxPoint x="0" y="-32" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e-push-api" value="Push auslösen" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.96;exitDx=0;exitDy=0;entryX=1;entryY=0.83;entryDx=0;entryDy=0;" edge="1" parent="1" source="pp" target="server">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="14" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e-push" value="Push" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="server" target="app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
